{
  "name": "nextjs-app-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "preview:offerings": "node scripts/offering-preview-server.mjs",
    "test": "node --test --import tsx tests/offerings-http.test.mjs tests/database-checker.test.mjs src/lib/offerings.test.ts",
    "test:db": "node --test tests/database-checker.test.mjs",
    "db:check": "node scripts/check-database.mjs",
    "db:check:write": "node scripts/check-database.mjs --write",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "mongoose": "^8",
    "next": "^14",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "^14",
    "eslint-config-prettier": "^9",
    "eslint-plugin-prettier": "^5",
    "husky": "^9",
    "lint-staged": "^15",
    "mongodb-memory-server-core": "^10.4.3",
    "prettier": "^3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
